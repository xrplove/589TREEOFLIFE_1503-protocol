# =============================================================================
# 1503 · plantilla de variables de entorno
# =============================================================================
#
# Copia este archivo a `.env.local` para desarrollo local y rellena los valores
# reales. Para producción (Vercel), configura cada variable desde Dashboard →
# Settings → Environment Variables. Marca explícitamente cuáles son
# `Production` vs `Preview` vs `Development`.
#
# NUNCA commitees `.env.local` ni `.env.production`. `.gitignore` los excluye.
#
# Convención de prefijos:
#   - `NEXT_PUBLIC_*` se exponen al navegador (cliente). NO usar para secretos.
#   - Sin prefijo = server-side only. Para secretos.
#
# =============================================================================
# OBLIGATORIAS · sin estas la app no arranca
# =============================================================================

# Supabase project URL (público · sale al navegador).
# Dashboard Supabase → Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key (público · sale al navegador · RLS protege la BD).
# Dashboard Supabase → Settings → API → Project API keys → anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Supabase service role key (SECRETO · server-side only · bypass RLS).
# Dashboard Supabase → Settings → API → Project API keys → service_role secret.
# Usado por endpoints API server-side para escribir en tablas append-only
# (consent_log · kyc_review_log · auth_attempt_log · etc.).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# URL pública del sitio (sin barra final). Usado por:
#   - verifySameOrigin() para CSRF defense en endpoints same-origin.
#   - Emails Resend (links de verificación + welcome + KYC decision).
#   - Magic links operador KYC review.
# Dev: http://localhost:3000
# Prod: https://www.1503.global
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# OBLIGATORIAS EN PRODUCCIÓN · sin estas la app rechaza ciertos flujos
# =============================================================================

# Secreto compartido para autenticación interna entre route handlers.
# Endpoints que lo requieren:
#   /api/auth/welcome-email
#   /api/auth/kyc-decision-email
# Generación segura (Linux/Mac/WSL):
#   openssl rand -base64 32
# Generación segura (Windows PowerShell):
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# Fail-closed en producción si no está configurada · permite paso en dev con warning.
# BLOQUEANTE pre-deploy (audit 23-may).
INTERNAL_API_SECRET=

# Lista de emails del staff operador con acceso al panel KYC review.
# Separados por comas. Cada email debe corresponder a un usuario existente en
# auth.users (creado vía scripts/create-operator.mjs).
# Migrar a emails @1503.global.
OPERATOR_EMAILS=operator@example.com

# =============================================================================
# EMAIL · Resend (transactional)
# =============================================================================

# Resend API key (SECRETO · server-side only).
# Dashboard Resend → API Keys.
# Status actual: sandbox · solo envía a base verificada hasta registrar dominio.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Sender email Resend (formato "Nombre <email@dominio>").
# Dev: onboarding@resend.dev (sandbox)
# Prod: noreply@1503.global (requiere dominio + verificación DNS)
RESEND_FROM=1503 <onboarding@resend.dev>

# =============================================================================
# GEOFENCE · MaxMind GeoIP2 (VPN-1 full)
# =============================================================================

# MaxMind license key para GeoIP2 web service (ASN datacenter detection).
# Sin esto, el geofence opera en modo LITE (Tor block + proxy/VPN log only).
# Provisionar cuenta en https://www.maxmind.com/en/geoip2-services-and-databases
MAXMIND_KEY=

# =============================================================================
# CHAT · WebSocket self-host (Fase 4 · pendiente · server no existe aún)
# =============================================================================

# URL del WebSocket server propio (Fase 4 self-host).
# Por ahora vacío · el cliente `app/lib/useChat.ts` no se conecta.
# Cuando se levante el server: wss://chat.1503.global o similar.
NEXT_PUBLIC_CHAT_WS_URL=

# =============================================================================
# CANDADO DE DEMO CERRADA (Basic Auth · capa 0 del middleware)
# =============================================================================
# Si AMBAS están definidas, toda la web queda tras un portero HTTP Basic Auth:
# el navegador pide usuario/contraseña una vez y no entra nadie sin ellas.
# Si se dejan VACÍAS o sin definir (p. ej. en local), el candado NO se activa.
# Solo para la demo de enseñar — NO sustituye al WAF/pentest (bloqueante pre-deploy).
DEMO_GATE_USER=
DEMO_GATE_PASSWORD=

# =============================================================================
# OPCIONALES · solo en self-host o desarrollo avanzado
# =============================================================================

# Si la app corre detrás de un proxy/load balancer que añade X-Forwarded-For
# de forma confiable (Vercel, Cloudflare, etc.), poner a "1" para que
# app/lib/request-ip.ts confíe en el header.
# En Vercel se puede dejar sin configurar (Vercel inyecta cf-connecting-ip).
# TRUST_FORWARDED_FOR=1

# Anthropic API key (uso futuro · IA Nivel A diferida Ola 2-3 self-host).
# Por ahora no se usa en código de la app · presente en .env.local solo para
# scripts externos opcionales.
# ANTHROPIC_API_KEY=

# =============================================================================
# AUTOMÁTICAS · NO configurar manualmente
# =============================================================================
#
# NODE_ENV          · gestionada por Next.js (development / production / test)
# VERCEL_ENV        · inyectada por Vercel (production / preview / development)
# VERCEL_URL        · inyectada por Vercel
# VERCEL_GIT_*      · inyectadas por Vercel (commit info)

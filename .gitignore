# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Continue.dev / IDE assistant config (contains API keys — must stay local)
/config.json

# Claude Code local config (per-developer, no debe ir al repo)
/.claude/

# Local dev server log
/dev.log

# Temporary commit message files
/.commit-msg.tmp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capturas de trabajo (no versionar)
caps/
.playwright-mcp/
